{
  "name": "auth-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "docker:db": "docker compose up -d",
    "docker:db:down": "docker compose down",
    "db:up": "docker compose up -d",
    "db:migrate": "docker compose up -d && node scripts/wait-for-db.mjs && prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "cd apps/api && pnpm run prisma:seed",
    "prisma:seed-dummy": "cd apps/api && pnpm run prisma:seed-dummy"
  },
  "dependencies": {
    "@prisma/client": "5.9.1"
  },
  "devDependencies": {
    "prisma": "5.9.1"
  }
}
